OPENAI_API_KEY=
OPENAI_LLM_MODEL=
PORT=8080
# whisper 원본 응답을 저장할 폴더 (샘플·mock용, 비우면 저장 안 함)
STT_DUMP_DIR=
# mock 모드: true면 키·네트워크 없이 backend/fixtures의 저장된 응답 사용 (시연 백업, 프론트 개발용)
MOCK_STT=false
MOCK_LLM=false
# 추가로 허용할 요청 출처 (쉼표로 구분, "https://*.example.com" 형식 가능, "*"면 모두 허용)
# localhost·사설 IP(같은 와이파이)·ngrok(https) 주소는 비워 둬도 기본으로 허용된다
CORS_ORIGIN=
